# Copy to .env and fill in values (or export in your shell / Render env vars)

# ── thingerz.com API push ──
THINGERZ_API_URL=https://thingerz.com/api/content
THINGERZ_API_KEY=your_valid_key_here

# ── Real search results for IG / Threads / 小紅書 / Douyin ──
# Get these at https://programmablesearchengine.google.com/ (free, 100 q/day)
GOOGLE_CSE_API_KEY=your_cse_api_key
GOOGLE_CSE_CX=your_cse_id
# Alternative/paid: https://serpapi.com
SERPAPI_KEY=your_serpapi_key
